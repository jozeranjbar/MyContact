<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_elevated"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatPeerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatPeerSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_not_connected"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chatStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_idle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <View
                android:id="@+id/chatStatusDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot_round" />

            <TextView
                android:id="@+id/tvChatStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/status_disconnected"
                android:textColor="@color/ink_soft"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnChatSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/settings_title"
            android:src="@android:drawable/ic_menu_manage" />

        <ImageButton
            android:id="@+id/btnStartCall"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/call_dialog_title"
            android:src="@android:drawable/sym_action_call" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmptyChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/empty_chat"
        android:textColor="@color/ink_faint"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_elevated"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageButton
            android:id="@+id/btnAttachFile"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/round_btn"
            android:contentDescription="@string/send_dialog_title"
            android:src="@android:drawable/ic_menu_attachment" />

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_code_box"
            android:hint="@string/msg_placeholder_disabled"
            android:inputType="textMultiLine|textCapSentences"
            android:enabled="false"
            android:maxLines="4"
            android:padding="10dp"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnSendMsg"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/round_btn_send"
            android:contentDescription="@string/btn_ok"
            android:enabled="false"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/primary_ink" />
    </LinearLayout>
</LinearLayout>
