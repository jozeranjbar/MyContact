<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/connectRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@color/bg_elevated">

        <ImageButton
            android:id="@+id/btnConnectBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_btn"
            android:contentDescription="@string/btn_cancel"
            android:src="@android:drawable/ic_media_previous" />

        <TextView
            android:id="@+id/tvConnectTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:gravity="center"
            android:text="@string/connect_title_starter"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_idle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot_round" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/status_ready"
                android:textColor="@color/ink_soft"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvConnectLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_elevated"
        android:fontFamily="monospace"
        android:maxLines="6"
        android:padding="8dp"
        android:textColor="@color/ink_soft"
        android:textSize="11sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== Starter: step 1 ===== -->
            <LinearLayout
                android:id="@+id/starterStep1Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvStep1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step1_offer_title"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/step1_offer_desc"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnRebuildCode"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_primary"
                    android:text="@string/btn_rebuild_code"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_ink" />
            </LinearLayout>

            <!-- ===== Starter: step 2 (offer) / Receiver: step 2 (answer) ===== -->
            <LinearLayout
                android:id="@+id/codeResultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvCodeResultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step2_offer_ready"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/code_share_desc"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etGeneratedCode"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_code_box"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:editable="false"
                    android:focusable="false"
                    android:padding="10dp"
                    android:scrollbars="vertical"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnShareCode"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_accent"
                        android:text="@string/btn_copy_share_offer"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_ink"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnShowQr"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_outline"
                        android:text="@string/btn_show_qr"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Starter: step 3 — paste answer ===== -->
            <LinearLayout
                android:id="@+id/answerInputCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvStep3Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step3_answer_title"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/step3_answer_desc"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etAnswerInput"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_code_box"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:hint="@string/answer_hint"
                    android:inputType="textMultiLine"
                    android:padding="10dp"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnConfirmConnect"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_primary"
                        android:text="@string/btn_confirm_connect"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_ink" />

                    <Button
                        android:id="@+id/btnScanAnswerQr"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_outline"
                        android:text="@string/btn_scan_qr"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Receiver: step 1 — paste offer ===== -->
            <LinearLayout
                android:id="@+id/receiverStep1Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvReceiverStep1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step1_receiver_title"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/step1_receiver_desc"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etOfferInput"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_code_box"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:hint="@string/offer_hint"
                    android:inputType="textMultiLine"
                    android:padding="10dp"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCreateAnswer"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_primary"
                        android:text="@string/btn_create_answer"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_ink" />

                    <Button
                        android:id="@+id/btnScanOfferQr"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_outline"
                        android:text="@string/btn_scan_qr"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
